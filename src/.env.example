ANTHROPIC_API_KEY=your-anthropic-api-key-here
# IBM Bob (Claude claude-3-5-haiku-20241022) API key — OPTIONAL
# Used for per-asset plain-English maintenance advisories.
# Without a key, the pipeline uses deterministic template-based fallbacks.
# Get your key at: https://console.anthropic.com/

MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/voltra
# MongoDB Atlas connection string — REQUIRED FOR AUTH
# Used for operator account storage (register/login).
# ML scoring, ranking, and advisory endpoints work without this.
# Free tier at: https://www.mongodb.com/cloud/atlas/register

JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
# Secret key used to sign JWT tokens — REQUIRED FOR AUTH
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"

JWT_ALGORITHM=HS256
# JWT signing algorithm — default HS256

JWT_EXPIRE_MINUTES=10080
# JWT token lifetime in minutes — default 10080 (7 days)

GROQ_API_KEY=gsk_your-groq-api-key-here
# Groq LPU API key — OPTIONAL
# Used for /api/groq-report (real-time 24-hour trajectory forecast).
# Get your key at: https://console.groq.com/

GEMINI_API_KEY=AIza_your-gemini-api-key-here
# Google Gemini Flash API key — OPTIONAL
# Used for /api/events/search (geospatial hazard area analysis).
# Get your key at: https://aistudio.google.com/app/apikey

GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# Google OAuth 2.0 client ID — OPTIONAL (only for Google sign-in)
# Create at: https://console.cloud.google.com/apis/credentials

GOOGLE_CLIENT_SECRET=GOCSPX-your-google-oauth-client-secret
# Google OAuth 2.0 client secret — OPTIONAL (only for Google sign-in)

API_BASE_URL=http://localhost:8000
# Public URL of this FastAPI server — used as OAuth callback redirect URI
# In production: set to your deployed server URL, e.g. https://voltra.railway.app

FRONTEND_URL=http://localhost:3000
# URL of the VOLTRA frontend — used to redirect after Google OAuth
# In production: set to your deployed frontend URL

# ── SMS Fault Alerts (SMS Gateway for Android) ────────────────────────────────
# Uses the open-source SMS Gateway for Android app (capcom6/android-sms-gateway).
# Your phone acts as the SMS sender.  App docs: https://docs.sms-gate.app
# All settings are OPTIONAL — if SMSGATE_USER/PASS are absent, SMS alerts are
# silently disabled and the rest of the system keeps working normally.

SMSGATE_USER=your_smsgateway_username
# Username shown in the app's "Cloud Server" section.

SMSGATE_PASS=your_smsgateway_password
# Password shown in the app's "Cloud Server" section.

SMSGATE_URL=https://api.sms-gate.app/3rdparty/v1/message
# Cloud API endpoint (default). For local Wi-Fi mode: http://<phone_ip>:8080/3rdparty/v1/message

SMSGATE_SIM=1
# SIM slot to send from (1 = SIM 1). Omit if the phone has only one SIM.

DAILY_LIMIT=50
# Max SMS sends per day (per process). Each recipient counts as one.
# Size this to (number_of_recipients x expected_faults_per_day).
# NOTE: counter resets on process restart.

ALERT_PHONE_NUMBERS=+91XXXXXXXXXX,+91XXXXXXXXXX
# Comma-separated list of Indian mobile numbers to receive fault alerts.
# Format: +919876543210  or  919876543210  or  9876543210
# Must start with 6-9 (Indian mobile prefix).
# REQUIRED for SMS alerts to be sent.
